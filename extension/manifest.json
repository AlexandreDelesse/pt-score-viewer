{
  "manifest_version": 3,
  "name": "PT Score Viewer — Pont cookie Pilotest",
  "version": "1.0.0",
  "description": "Transmet automatiquement la session pilotest.com à l'app pt-score-viewer après une connexion manuelle, pour éviter de copier le cookie à la main.",
  "permissions": ["cookies"],
  "host_permissions": [
    "https://www.pilotest.com/*",
    "http://localhost:5173/*",
    "http://localhost:4173/*",
    "https://piscovi.ade-dev.fr/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:5173/*",
        "http://localhost:4173/*",
        "https://piscovi.ade-dev.fr/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
